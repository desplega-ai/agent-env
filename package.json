{
  "name": "@desplega.ai/agent-env",
  "version": "0.6.0",
  "description": "Run development services behind stable localhost addresses.",
  "type": "module",
  "bin": {
    "agent-env": "./bin/agent-env.mjs"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node test/run.mjs",
    "test:core": "node test/run.mjs core",
    "test:docker": "node test/run.mjs docker",
    "test:runtime": "node test/runtime-e2e.mjs",
    "test:features": "node test/run.mjs features",
    "test:compose": "node test/run.mjs compose",
    "test:ssh": "node test/run.mjs ssh",
    "test:s3": "node test/run.mjs s3",
    "test:cloud": "node test/run.mjs cloud",
    "test:devcontainer": "node test/run.mjs devcontainer",
    "test:e2b": "node test/run.mjs e2b",
    "test:sdk": "node test/sdk.e2e.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "bin",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "examples",
    "docs",
    "assets"
  ],
  "license": "MIT",
  "author": "Desplega Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desplega-ai/agent-env.git"
  },
  "homepage": "https://github.com/desplega-ai/agent-env#readme",
  "bugs": {
    "url": "https://github.com/desplega-ai/agent-env/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@devcontainers/cli": "0.90.0",
    "e2b": "2.63.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "main": "./src/sdk.mjs",
  "types": "./src/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./src/sdk.d.ts",
      "import": "./src/sdk.mjs",
      "default": "./src/sdk.mjs"
    }
  }
}
